# Salin ke .env untuk pengembangan lokal. Jangan commit .env.
# Semua nilai VITE_* ditanam ke bundle saat build dan terlihat oleh siapa pun yang membuka aplikasi,
# jadi tidak boleh ada secret di sini. Mengubah nilainya berarti build ulang, bukan deploy ulang.
# Di server, nilai ini masuk sebagai --build-arg lewat substitusi cloudbuild.yaml.

# Origin backend saja: skema dan host, tanpa path dan tanpa slash di belakang.
# Klien menambahkan api/v1 sendiri. Contoh salah: https://host/api, https://host/api/v1, https://host/
VITE_API_BASE_URL=http://localhost:8080

# Cara masuk: sso (alihkan ke halaman login SSO bersama) atau stopgap (form NIP dan kata sandi lokal).
# Harus sama dengan AUTH_MODE di backend.
VITE_AUTH_MODE=stopgap

# Halaman login SSO bersama. Wajib diisi pada VITE_AUTH_MODE=sso, diabaikan pada stopgap.
# Nilai sebenarnya dikonfirmasi ke pemilik Identity Provider.
VITE_SSO_LOGIN_URL=
